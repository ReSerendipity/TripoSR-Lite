{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "TripoSR-Lite 桌面壳主能力：加载页事件、启动控制与模型目录引导",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-app-info",
    "allow-get-startup-status",
    "allow-retry-start",
    "allow-open-model-dir",
    "allow-check-update",
    "allow-install-update"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  }
}
